{
  "trailingSlash": true,
  "buildCommand": "node build.js",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ]},
    { "source": "/(.*)\\.html", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] },
    { "source": "/(.*)\\.webmanifest", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(.*)\\.png", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
